{
  "name": "PHP + MariaDB Web-Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "forwardPorts": [8080, 3306, 8081],
  "portsAttributes": {
    "8080": { "label": "PHP Server", "onAutoForward": "notify" },
    "3306": { "label": "MariaDB", "onAutoForward": "silent" },
    "8081": { "label": "Adminer", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.live-server"
      ]
    }
  }
}
